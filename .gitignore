node_modules/
frontend/node_modules/
frontend/.next/
frontend/playwright-report/
frontend/test-results/
test-results/
out/
.vercel/
exports/*.md
!exports/.gitkeep

# Environment files
# `.env` alone does not match `.env.local` / `.env.production` etc, so match the
# whole family everywhere. Real secrets (CLERK_SECRET_KEY, DATABASE_URL, …) live
# in these; only *.example files are ever committed.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python artifacts
__pycache__/
*.pyc
*.egg-info/
backend/.venv/
backend/.pytest_cache/

# IDE / editor
.cursor/
